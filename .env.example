# Neon Postgres. Use the pooled connection string for the app and the direct one for migrations.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/epicaid?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/epicaid?sslmode=require"

# Upstash Redis (REST)
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN=""

# OpenRouter
OPENROUTER_API_KEY=""

# Models for Ingestion (optional; see `pnpm cli` for defaults)
# EXTRACTION_MODEL="deepseek/deepseek-v4-flash-0731"
# SUMMARY_MODEL="deepseek/deepseek-v4-flash-0731"
